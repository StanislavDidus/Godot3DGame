[node name="cauldron" parent="." unique_id=1382961925 node_paths=PackedStringArray("dialogue_window", "projector_lens") instance=ExtResource("12_eb6dy")]
transform = Transform3D(0.67963344, 0, 0.73355186, 0, 1, 0, -0.73355186, 0, 0.67963344, -14.111905, 2.2377932, 0.67861295)
dialogue_window = NodePath("../DialogueWindow")
post_trophy_message = "Hmm. A trophy. You know it has a name on in. Jessica Denz. Denz. Just as your last name I presume. Ha. Seems she was quite successful in sport. Pity you can't remember her. Now find a ring for me please."
post_trophy_message2 = "What? I had a child. Is this some kind of trap for me? What have I done? I still don't remember anything. My mind is like a huge ocean. Fuck. What is it? You are giving me a projector lens. "
projector_lens = NodePath("../projector_lens")
post_ring_message = "You gave me a ring. But it does not belong to me. It is yours. Well it is quite obvious. Because it is from your future. Yes Marvin, it hasn't happened yet. The trophy and the ring they belong to your future."
post_ring_message2 = "The trophy is of your future daughter that will win a tournament at tennis. And the ring is the ring you will get on your wedding. You will have a wife Marvin."
post_ring_message3 = "It seems quite impossible to you but it is quite true. You don't remember what happened to you or how you got here but it doesn't matter. Everything that matters is your bright future outside. You just need to leave this basement and live it."
metadata/_edit_group_ = true

